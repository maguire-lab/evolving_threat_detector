{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/etd/master/assets/schema_input.json",
    "title": "nf-core/etd pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "gbk": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.gbk$",
                "errorMessage": "GenBank file must be provided, cannot contain spaces and must end in '.gbk'"
            },
            "organism": {
                "type": "string",
                "pattern": "^[A-Za-z]+(_[a-z]+)?$",
                "description": "AMRFinderPlus organism name (e.g. Staphylococus_aureus)",
                "errorMessage": "Organism must be and follow the AMRFinderPlus naming format",
                "meta": ["organism"]
            }
          },
        "required": ["sample", "gbk"]
    }
}
